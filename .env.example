# Optional AI connection. Ghost does not automatically load this file.
# Prefer `ghost connect <provider> --model <id>` for nonsecret repo settings.
# Supported: openai, claude/anthropic, codex, compatible, openrouter, ollama.
# Environment settings override saved .ghost/llm.json settings.
# GHOST_PROVIDER=compatible
# GHOST_MODEL=your-model-id
# GHOST_BASE_URL=https://your-provider.example/v1
# GHOST_KEY_ENV=YOUR_KEY_VARIABLE
# GHOST_API_KEY=                  # Legacy key; overrides default provider key variables
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Codex uses the installed `codex` CLI login. Local Ollama needs no API key.
